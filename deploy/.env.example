# Скопируйте в deploy/.env и впишите свои значения.
# DOMAIN — домен статики (A-запись на IP VPS, в Cloudflare — DNS only/серая тучка).
# SERVER_ADDR — адрес игрового сокета для браузера: <ПУБЛИЧНЫЙ_IP_VPS>:6001.
#   Голая ссылка https://DOMAIN редиректится на /?server=SERVER_ADDR.
DOMAIN=game.example.com
SERVER_ADDR=203.0.113.1:6001
