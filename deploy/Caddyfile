# Статика браузерного клиента + живой digest игрового сервера.
# TLS (Let's Encrypt) Caddy получает и продлевает сам — домен из deploy/.env.
{$DOMAIN} {
	encode zstd gzip

	# Голая ссылка (https://домен без ?server=) → редирект с адресом игрового
	# сокета из .env: игрокам достаточно домена, IP помнить не нужно.
	@noserver {
		path /
		not query server=*
	}
	redir @noserver /?server={$SERVER_ADDR} temporary

	# /certificates/digest.txt — ЖИВОЙ digest из каталога игрового сервера
	# (протухший digest из сборки dist/ сюда не попадает: см. WEB_CLIENT.md).
	# no-store ОБЯЗАТЕЛЕН: digest меняется при каждом рестарте game, а браузер
	# без этого заголовка кэширует файл эвристически — после рестарта клиент
	# коннектился бы со старым digest (TLS certificate unknown) даже после F5.
	handle_path /certificates/* {
		root * /srv/live-certificates
		header Cache-Control "no-store"
		file_server
	}

	handle {
		root * /srv/dist
		file_server
	}
}
