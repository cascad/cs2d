target/
# локальные сборки/пакеты (zip с бинарём+assets) — артефакты, не в репозиторий
dist/
# TLS-артефакты сервера: digest пересоздаётся при каждом старте. Сам каталог
# держим в репе (.gitkeep) — trunk копирует его в dist (copy-dir в index.html),
# и сборка не должна падать на свежем клоне.
certificates/*
!certificates/.gitkeep
# диагностические скриншоты в корне (assets/**/*.png НЕ трогает)
/*.png
# локальные конфиги вторых серверов для параллельных тестов
/server_config_*.toml
!/server_config.toml
# деплой: локальное окружение и данные рантайма
deploy/.env
deploy/data/
# персистентность аккаунтов локального сервера (в docker — том deploy/data/state)
/state/
